%appinstall snippy

cp /docker_context/snippy_environment.yml .
# create and provision the environment, utilizing
# the environment name specified in the file ("snippy").
micromamba install --yes --name base --file snippy_environment.yml

%apprun snippy
#we're running snippy within the  snippy environment here...
CMD="snippy $@"
echo "Running . . . $CMD"
$CMD

%apprun snippy_sciduct
mkdir -p $SCIF_APPDATA
#extract params from /job/job.json
#NAME="$(jq -r .input.name /job/job.json)"
#scif run snippy -- ....params...