%appinstall varifier
# copy the env file into the container, to have it
# available in case anyone wants to use it to
# test the varifier app, without the container
# The current directory for this %appinstall will
# be /scif/apps/varifier.
cp /docker_context/varifier_environment.yml .
# create and provision the environment, utilizing
# the environment name specified in the file ("varifier").
micromamba install --yes --name base --file varifier_environment.yml

%apprun varifier
#we're running varifier within the  varifier environment here...
CMD="varifier $@"
echo "Running . . . $CMD"
$CMD

%apprun varfier_sciduct
mkdir -p $SCIF_APPDATA
#extract params from /job/job.json
#NAME="$(jq -r .input.name /job/job.json)"
#scif run varifier -- ....params...