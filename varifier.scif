%appinstall varifier
micromamba create --yes --file /docker_context/varifier_env.yml

#the vt that gets installed doesnt' seem to work completly.  It may be missing some formats/compressions
#this links to the vt that ships with clockwork image.
rm $MAMBA_ROOT_PREFIX/envs/varifier/bin/vt 
ln -s /bioinf-tools/vt $MAMBA_ROOT_PREFIX/envs/varifier/bin/vt

%apprun varifier
#we're running varifier within the  varifier environment here...
CMD="micromamba run --name varifier varifier $@"
echo "Running . . . $CMD"
$CMD

%apprun varfier_sciduct
mkdir -p $SCIF_APPDATA
#extract params from /job/job.json
#NAME="$(jq -r .input.name /job/job.json)"
#scif run varifier -- ....params...