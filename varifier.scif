%appinstall varifier
micromamba create --yes --file /docker_context/varifier_env.yml

%apprun varifier
#we're running varifier within the  varifier environment here...
CMD="micromamba run --name varifier varifier $@"
echo "Running . . . $CMD"
$CMD

%apprun varfier_sciduct
mkdir -p $SCIF_APPDATA
