%appinstall vcfdist
micromamba create --yes --file /docker_context/vcfdist_env.yml

%apprun vcfdist
#we're running varifier within the  varifier environment here...
CMD="micromamba run --name vcfdist vcfdist $@"
echo "Running . . . $CMD"
$CMD

%apprun vcfdist_sciduct
mkdir -p $SCIF_APPDATA
