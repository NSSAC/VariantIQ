%apprun minos
echo "Running 'minos $@'"
exec minos $@

%apprun bcftools
excec bcftools $@

%apprun minos-samtools
excec samtools $@

%apprun vt
exec vt $@

%apprun minos_sciduct
mkdir -p $SCIF_APPDATA
